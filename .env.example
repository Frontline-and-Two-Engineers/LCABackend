# Telegram Bot & Native MTProto Configuration
BOT_TOKEN=123456789:ABCDEFghijklmnopqrstuvwxyz1234567

# Telegram API ID & Hash (Get free from https://my.telegram.org -> API development tools)
# Required for native MTProto protocol and MTProxy support
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Native MTProto Proxy (Optional: tg://proxy?server=...&port=...&secret=...)
# MTPROTO_PROXY_HOST=proxy.example.com
# MTPROTO_PROXY_PORT=443
# MTPROTO_PROXY_SECRET=ee1234567890abcdef1234567890abcdef

# Fallback SOCKS5 / HTTP Proxy (Optional)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Security & Tokens
JWT_SECRET=your-very-secret-key-change-me-generate-random-string
ADMIN_API_TOKEN=super-secret-admin-token-for-launcher-api

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite+aiosqlite:///./data/lca_auth.db

# Launcher API Server
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://localhost:8080

# Time To Live Settings
CODE_TTL_SECONDS=300
TOKEN_TTL_DAYS=30

# Administrators (comma-separated Telegram IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Modpack Storage Directory
MODPACK_DIR=./data/modpack
